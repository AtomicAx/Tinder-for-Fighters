{
  "expo": {
    "name": "expo_tinderforfighters",
    "slug": "expo_tinderforfighters",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "expotinderforfighters",
    "owner": "tooshort32",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.tooshort32.expo-tinderforfighters",
      "ITSAppUsesNonExemptEncryption": false
    },
    "plugins": [
      "expo-secure-store"
    ],
    "android": {
      "package": "com.tooshort32.expotinderforfighters"
    }
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#ffffff"
    },
    "package": "com.tooshort32.expo_tinderforfighters"
  },
  "web": {
    "favicon": "./assets/favicon.png"
  },
  "plugins": [
    "expo-apple-authentication",
    "expo-web-browser"
  ],
  "extra": {
    "eas": {
      "projectId": "cb33a9d4-c8e0-4013-b0f7-81b84a0fe52d"
    }
  }
}
